X:1
T:Small Band
C:Music by You
M:4/4
L:1/16
Q:1/4=100
%%score {(pianoR) (pianoL)} (gtr) (egtr) (lead) (kit)
V:pianoR clef=treble name="Piano"
V:pianoL clef=bass
V:gtr clef=treble name="Gtr"
V:egtr clef=treble name="Egtr"
V:lead clef=treble name="Lead"
V:kit clef=perc name="Kit"
K:Am
[V:pianoR] "^con Ped."z8 !mp![CE]8 | z8 [A,C]8 | z8 [EG]8 | z8 [B,D]8 |
[V:pianoL] !>!A,,16 | !>!F,,16 | !>!C,16 | !>!G,,16 |
[V:gtr] !mf!A,,2!arpeggio![A,CE]2 z4 [CE]8 | F,,2!arpeggio![F,A,C]2 z4 [A,C]8 | C,2!arpeggio![CEG]2 z4 [EG]8 | G,,2!arpeggio![G,B,D]2 z4 [B,D]8 |
[V:egtr] z4 !mf!A2 z2 z4 z2 c2 | z4 F2 z2 z4 z2 A2 | z4 c2 z2 z4 z2 e2 | z4 G2 z2 z4 z2 B2 |
[V:lead] !f!A2c2 e2a2 g2e2 c2A2 | F2A2 c2f2 e2c2 A2F2 | z16 | z16 |
[V:kit] !mf!kick2 z2 snare2 z2 kick2 z2 snare2 z2 | kick2 z2 snare2 z2 kick2kick2 snare2 z2 | z16 | z16 |
